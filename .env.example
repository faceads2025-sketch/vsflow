# ----- Banco de dados (PostgreSQL) -----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/conversaflow?schema=public"

# ----- App -----
# Define como "mock" para rodar sem banco/redis (dados em memória).
# Use "db" para usar Prisma + PostgreSQL.
DATA_SOURCE="mock"
APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="troque-este-segredo"

# ----- Modo de envio de WhatsApp -----
# "mock"  -> só loga no console (default)
# "zapi"  -> Z-API (WhatsApp gerenciado na nuvem; recomendado, sem gateway local)
# "web"   -> WhatsApp Web NÃO-OFICIAL via Baileys (login por QR, rode `npm run wa`)
# "cloud" -> WhatsApp Cloud API oficial
WHATSAPP_MODE="mock"

# ----- Z-API (modo "zapi") -----
# Pegue na sua conta em https://app.z-api.io (instância + segurança)
ZAPI_INSTANCE_ID=""
ZAPI_TOKEN=""
ZAPI_CLIENT_TOKEN=""
# Configure o webhook "Ao receber" do Z-API para: https://SEU_APP/api/zapi/webhook

# ----- Gateway WhatsApp Web (modo "web") -----
WA_GATEWAY_URL="http://localhost:4001"
WA_GATEWAY_PORT="4001"
APP_WEBHOOK_URL="http://localhost:3000/api/webhook/whatsapp"
# Anti-ban: atrasos e limites de envio
WA_MIN_DELAY_MS="4000"
WA_MAX_DELAY_MS="12000"
WA_HOURLY_LIMIT="60"
WA_DAILY_LIMIT="500"

# ----- Redis / BullMQ (filas de disparo e automações) -----
REDIS_URL="redis://localhost:6379"

# ----- WhatsApp Cloud API (oficial) -----
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="conversaflow-verify-token"
WHATSAPP_API_VERSION="v20.0"
